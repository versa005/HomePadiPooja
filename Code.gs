const SHEET_NAME='RSVPs';
function doPost(e){try{const d=JSON.parse(e.postData.contents);if(!d.eventId||!d.name||!d.phone)throw Error('Missing fields');const ss=SpreadsheetApp.getActiveSpreadsheet();let sheet=ss.getSheetByName(SHEET_NAME);if(!sheet){sheet=ss.insertSheet(SHEET_NAME);sheet.appendRow(['Timestamp','Event ID','Name','Phone','Email','Response','Adults','Children','Message'])}const safe=x=>{const s=String(x??'').slice(0,500);return /^[=+@-]/.test(s)?'\''+s:s};sheet.appendRow([new Date(),safe(d.eventId),safe(d.name),safe(d.phone),safe(d.email),safe(d.response),Math.max(0,Number(d.adults)||0),Math.max(0,Number(d.children)||0),safe(d.message)]);return ContentService.createTextOutput(JSON.stringify({ok:true})).setMimeType(ContentService.MimeType.JSON)}catch(err){return ContentService.createTextOutput(JSON.stringify({ok:false,error:String(err)})).setMimeType(ContentService.MimeType.JSON)}}
